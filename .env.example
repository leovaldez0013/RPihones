# Banco: SQLite local (padrão) ou PostgreSQL (produção: Neon/Supabase)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo do Auth.js — gere com: npx auth secret  (ou qualquer string aleatória longa)
AUTH_SECRET="troque-por-um-segredo-aleatorio"
AUTH_TRUST_HOST=true

# Opcional: protege a rota /api/cron/tarefas (Vercel Cron envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Opcional: chave da API de consulta de IMEI (também pode ser definida em Configurações)
IMEI_API_URL=""
IMEI_API_KEY=""
